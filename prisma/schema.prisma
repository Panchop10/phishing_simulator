// Simulador de Phishing — esquema de datos
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

enum TrackingEventType {
  OPEN
  CLICK
}

// Único administrador, creado por el asistente de configuración inicial.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

// Fila única ("singleton"); se edita en la página de Configuración.
model AppSettings {
  id                       String   @id @default("singleton")
  appBaseUrl               String?
  orgName                  String?
  securityContactEmail     String?
  smtpHost                 String?
  smtpPort                 Int      @default(587)
  smtpSecure               Boolean  @default(false)
  smtpUser                 String?
  smtpPasswordEnc          String? // AES-256-GCM (clave = APP_ENCRYPTION_KEY)
  mailFromName             String?
  mailFromEmail            String?
  mailReplyTo              String?
  allowedRecipientDomains  String? // lista separada por comas; vacío = permitir todos (con advertencia)
  sendRatePerMinute        Int      @default(60)
  sendBatchSize            Int      @default(25)
  maxRecipientsPerCampaign Int      @default(5000)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)
}

model Template {
  id         String     @id @default(cuid())
  name       String
  subject    String
  bodyHtml   String // HTML con {{nombre}}, {{enlace}}
  archivedAt DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
  campaigns  Campaign[]

  @@index([archivedAt])
}

model Campaign {
  id                String              @id @default(cuid())
  name              String
  status            CampaignStatus      @default(DRAFT)
  templateId        String?
  template          Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subjectSnapshot   String? // copias inmutables capturadas al lanzar
  bodyHtmlSnapshot  String?
  fromName          String?
  fromEmail         String?
  authorizedBy      String?
  authorizationNote String?
  launchedAt        DateTime?           @db.Timestamptz(6)
  completedAt       DateTime?           @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  recipients        CampaignRecipient[]
  events            TrackingEvent[]

  @@index([status])
  @@index([createdAt])
}

model CampaignRecipient {
  id             String          @id @default(cuid())
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email          String
  nombre         String?
  cargo          String?
  departamento   String?
  token          String          @unique // base64url de 256 bits; usado para apertura + clic
  status         RecipientStatus @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime?       @db.Timestamptz(6)
  lockedAt       DateTime?       @db.Timestamptz(6)
  sentAt         DateTime?       @db.Timestamptz(6)
  messageId      String?
  lastError      String?
  firstOpenedAt  DateTime?       @db.Timestamptz(6)
  firstClickedAt DateTime?       @db.Timestamptz(6)
  openCount      Int             @default(0)
  clickCount     Int             @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  events         TrackingEvent[]

  @@unique([campaignId, email])
  @@index([status, nextAttemptAt])
  @@index([campaignId, status])
  @@index([campaignId, firstOpenedAt])
  @@index([campaignId, firstClickedAt])
}

model TrackingEvent {
  id                  String            @id @default(cuid())
  campaignRecipientId String
  campaignId          String
  recipient           CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  campaign            Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type                TrackingEventType
  ipHash              String? // HMAC(ip), nunca la IP en bruto
  userAgent           String?
  suspectedBot        Boolean           @default(false)
  occurredAt          DateTime          @default(now()) @db.Timestamptz(6)

  @@index([campaignId, type])
  @@index([campaignRecipientId, type])
  @@index([campaignId, occurredAt])
}
