# ------------------------------------------------------------------
# Variables de ARRANQUE (bootstrap). El resto de la configuración
# (SMTP, URL pública, dominios permitidos, etc.) se ajusta DESDE EL
# PANEL en la página de Configuración, no aquí.
#
# ./start.sh genera este archivo automáticamente con secretos aleatorios.
# ------------------------------------------------------------------

# Base de datos (docker-compose la usa para el contenedor Postgres incluido)
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esto-por-un-secreto
POSTGRES_DB=phishing

# Secretos de la aplicación (>= 32 caracteres). Genera con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-32-caracteres-o-mas-aleatorios
APP_ENCRYPTION_KEY=cambia-esto-por-32-caracteres-o-mas-aleatorios
IP_HASH_SECRET=cambia-esto-por-un-secreto-aleatorio

# Opcional: URL pública (si la dejas vacía, la defines en Configuración)
APP_BASE_URL=

# Puerto público en el host
APP_PORT=3000

# --- Solo para ejecución SIN Docker (desarrollo local con Postgres propio) ---
# DATABASE_URL=postgresql://app:app@localhost:5432/phishing?schema=public
